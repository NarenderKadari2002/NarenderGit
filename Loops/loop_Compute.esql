

CREATE COMPUTE MODULE loop_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		
		
		DECLARE count INTEGER;
		
		DECLARE str,str1 CHARACTER;
		
		DECLARE i INTEGER 1;
		
		DECLARE inref REFERENCE TO InputRoot.XMLNSC.Inventory.Item;
		
		
		set count = CARDINALITY(inref.Item.[] /*inref.Item.[]*/); --cardinality is used to get the count of tags if we add . after the gtag will get the number of siblings in the parent tag
		
