			--CREATE FIRSTCHILD OF outref.Extra ;
			--CREATE LASTCHILD OF outref.Extra ;
			
			move inref TO inref.Item.[<];
			
			set outref =inref;*/
		-----Repeat---- --It is used to repeat set of statements until th condition satifies
		
		/*CREATE FIELD OutputRoot.XMLNSC.NewInventory;
		
		DECLARE outref REFERENCE TO OutputRoot.XMLNSC.NewInventory;
		
		REPEAT
			
			 set outref.ITEM[i].ItemID=inref.Item[i].ItemID;
				set outref.ITEM[i].Name=inref.Item[i].Name;
				set outref.ITEM[i].Quantity=inref.Item[i].Quantity;
				set outref.ITEM[i].Price=inref.Item[i].Price;
			    set i=i+1;
			
		UNTIL i=count
			
		END REPEAT; */
		
		-----While----- -- It is used to uterate the statements untill the condition satisfies when we dont know how many tuimes needs to be iterated.
		
		/*CREATE FIELD OutputRoot.XMLNSC.NewInventory;
		
		DECLARE outref REFERENCE TO OutputRoot.XMLNSC.NewInventory;
				
