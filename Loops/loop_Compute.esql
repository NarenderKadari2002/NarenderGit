				set outref.ITEM[i].Price=inref.Item[i].Price;
			set i=i+1;
			--ITERATE X;--Iterate is optional it is used to iterate the loop
			ELSE
				LEAVE X; --Leave is used to exit the loop labeled X
			END IF;
