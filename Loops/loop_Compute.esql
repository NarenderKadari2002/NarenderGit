				set outref.ITEM[i].Price=inref.Price;
			    set i=i+1;
			    MOVE inref NEXTSIBLING;
			
		END WHILE;*/
		
		CREATE FIELD OutputRoot.XMLNSC.NewInventory;
		
		DECLARE outref REFERENCE TO OutputRoot.XMLNSC.NewInventory;
		
		
		
		FOR inref AS InputRoot.XMLNSC.Inventory.Item[]  DO  --FOR loop is used to move to next sibling directly instead of using MOVE TO NEXTSIBLING while iterating everytime. For the FOR loop always needs to give array referencwe.
			
			 set outref.ITEM[i].ItemID=inref.ItemID;
				set outref.ITEM[i].Name=inref.Name;
				set outref.ITEM[i].Quantity=inref.Quantity;
				set outref.ITEM[i].Price=inref.Price;
				set i=i+1;
			
		END FOR;

		
		Return TRUE;
	END;
END MODULE;
