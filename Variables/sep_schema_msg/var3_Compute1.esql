BROKER SCHEMA sep_schema_msg


CREATE COMPUTE MODULE var3_Compute1
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		--set Environment.var=share;
		IF Environment.var is not null  THEN
			SET OutputRoot.XMLNSC.Result = 'Normal variable declared in schema level of one msg flow is in scope  with in the seperate msg flow with same schema name';
		ELSE
			SET OutputRoot.XMLNSC.Result ='Normal Variable is out of scope';
		END IF;
		RETURN TRUE;
	END;
END MODULE;
