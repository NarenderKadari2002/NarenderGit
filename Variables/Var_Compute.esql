		ELSEIF EXISTS(inref.Dept[])=True THEN
			--Set Environment.Data =share;
			SET OutputRoot.XMLNSC.Name = share;
			
			PROPAGATE TO TERMINAL 1;
			
		ELSEIF EXISTS(inref.Section[])=True THEN
			--Set Environment.Data =share; -- enviroment cannot be used in another msg flow with the same schema name or diff but can be used in subflows with same schema and diff schema name.
			SET OutputRoot.XMLNSC.Name = share;
			
			
			--PROPAGATE TO TERMINAL 2;
		END IF;
		
