-----Common Exception handler Code ------------------
BROKER SCHEMA ESBCommonLib

CREATE COMPUTE MODULE CommonErrorHandler
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		DECLARE errorText CHARACTER '';
		DECLARE DiagnosticText CHARACTER '';
		DECLARE roll INTEGER 1;
		DECLARE pathref REFERENCE TO InputExceptionList.*[roll];
		WHILE LASTMOVE(pathref) AND CONTAINS(UPPER(FIELDNAME(pathref)),'EXCEPTION') DO
			WHILE CONTAINS(UPPER(FIELDNAME(pathref.*[<])),'EXCEPTION') DO
				MOVE pathref LASTCHILD; 
			END WHILE;
			IF errorText='' THEN
				SET errorText = pathref.Text;
			ELSE
				SET errorText =errorText ||' | '||pathref.Text;			
			END IF;
			CASE
				
			WHEN EXISTS(pathref.Insert[]) THEN
				MOVE pathref FIRSTCHILD TYPE Name NAME'Insert';
				WHILE LASTMOVE(pathref) DO
					SET DiagnosticText = DiagnosticText ||' '|| pathref.Text;
					MOVE pathref NEXTSIBLING;
				END WHILE;
			ELSE
				SET DiagnosticText =DiagnosticText ||'|'|| errorText;
			END CASE;
			SET roll=roll+1;
			MOVE pathref TO InputExceptionList.*[roll];
		END WHILE;
		SET OutputRoot.JSON.Data.Exception = errorText ||' | ' || DiagnosticText;
		RETURN TRUE;
	END;
	
	 
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
		
		
	END;
END MODULE;
